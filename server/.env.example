# Copy this file to server/.env and fill in what you need. server/.env is git-ignored; never commit real values.

# MongoDB: local Docker (docker compose up -d) or a MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/startup-finder
PORT=4000

# --- Optional: AI-written outreach drafts -------------------------------------------------------------
# Leave ANTHROPIC_API_KEY empty to use template-based drafts only (everything still works).
# The key is read by the server process only. It is never sent to the browser or written to logs.
ANTHROPIC_API_KEY=
# Optional overrides:
# OUTREACH_AI_MODEL=claude-opus-5-5
# OUTREACH_AI=off            # force template-only mode even if a key is set

# --- Optional: research role keywords (comma separated; replaces the defaults) --------------------------
# RESEARCH_ROLE_KEYWORDS=engineer,developer,backend,ai,ml
